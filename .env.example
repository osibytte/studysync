# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# The EXPO_PUBLIC_ prefix is required — Expo only exposes prefixed vars to the
# app bundle. Anything without it stays server-side and will read as undefined.
#
# Both of these values are safe to ship in a mobile app. The anon key is
# designed to be public; it is the RLS policies, not the key, that keep one
# student's data away from another. That is why RLS is non-negotiable here.
#
# NEVER put the service_role key in this file or anywhere in the app bundle.
# It bypasses RLS entirely. It belongs only in Edge Function secrets (Stage 2).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
