{
  "expo": {
    "name": "StudySync",
    "slug": "studysync",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "studysync",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.studysync.app"
    },
    "android": {
      "package": "com.studysync.app",
      "adaptiveIcon": {
        "backgroundColor": "#12263A"
      },
      "permissions": ["SCHEDULE_EXACT_ALARM"]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12263A",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
